{
  "name": "expense-tracker",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --concurrency=2",
    "build": "turbo run build --concurrency=2",
    "typecheck": "turbo run typecheck --concurrency=2",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate:local": "wrangler d1 migrations apply expense-tracker-dev --local --config apps/api/wrangler.toml",
    "db:migrate:prod": "wrangler d1 migrations apply expense-tracker --remote --env production --config apps/api/wrangler.toml"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@cloudflare/workers-types": "^5.20260724.1",
    "turbo": "^2.10.6",
    "typescript": "^7.0.2",
    "wrangler": "^4.114.0"
  }
}
