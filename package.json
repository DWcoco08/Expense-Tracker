{
  "name": "expense-tracker",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --concurrency=3",
    "build": "turbo run build --concurrency=3",
    "typecheck": "turbo run typecheck --concurrency=3",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate:local": "wrangler d1 migrations apply expense-tracker-dev --local --config apps/api/wrangler.toml",
    "db:migrate:prod": "wrangler d1 migrations apply expense-tracker --remote --env production --config apps/api/wrangler.toml",
    "prepare": "lefthook install",
    "test:e2e": "codeceptjs run --steps"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@cloudflare/workers-types": "^5.20260724.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.2.0",
    "codeceptjs": "^4.1.0",
    "lefthook": "^2.1.10",
    "playwright": "^1.62.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "turbo": "^2.10.6",
    "typescript": "^7.0.2",
    "wrangler": "^4.114.0"
  }
}
